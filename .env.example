# ElevenLabs の API キー。https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# A: Agents Platform で使う Agent の id（`agent_...`）。まだ作っていなければ空でよい
ELEVENLABS_AGENT_ID=

# C: Knowledge Base 構成の Agent の id（`agent_...`）。`voicelab setup-kb` が書く
# A とは別の Agent。道具を持たない代わりに、ノート本文を ElevenLabs 側に預けてある
ELEVENLABS_KB_AGENT_ID=

# 声。既定は無料プランでも使える premade のうち日本語が検証済みの "Jessica"（ほかに George / Alice）。Sarah は日本語未検証
# 日本語ネイティブの声（"Aya" = MXKtCrra8fvlDUbfKUT1）は Starter 以上
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# TTS モデル。会話用は flash（速い方）を使う
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# B（ElevenLabs）が使う TTS モデル。空なら ELEVENLABS_MODEL_ID。stream-input では eleven_v3 系は使えない（403）
VOICELAB_TTS_MODEL=

# Agent の応答生成に使う LLM。既定は gemini-3.6-flash（速くて安い）
VOICELAB_LLM=gemini-3.6-flash

# B（自前構成）が使う Gemini の API キー。https://aistudio.google.com/apikey
# A は ElevenLabs 側が同じモデル（VOICELAB_LLM）を動かすので鍵は要らない
GEMINI_API_KEY=

# D: Deepgram 構成（B の TTS だけを Deepgram Aura-2 に替えたもの。検索と Gemini は B と同じ）。
# https://console.deepgram.com → API Keys。残高（/balances）まで読むなら billing:read の権限が要る
# （無くても計測は動く。voicelab credits に「確かめられませんでした」と 1 行出るだけ）
# project: 982ca49d-dd33-4a38-b6cb-3803cbfc1129
DEEPGRAM_API_KEY=

# D の TTS モデル（Deepgram では声とモデルが 1 つの id）。日本語を持つのは Aura-2 の 5 声だけ
# （2026-09-25 に GET /v1/models で確認）: aura-2-izanami-ja（既定・女性）/ aura-2-uzume-ja（女性）/
# aura-2-ama-ja（女性）/ aura-2-fujin-ja（男性）/ aura-2-ebisu-ja（男性）
DEEPGRAM_TTS_MODEL=aura-2-izanami-ja

# OpenAI 構成（B の TTS だけを OpenAI の gpt-4o-mini-tts に替えたもの。検索と Gemini は B と同じ）。
# https://platform.openai.com/api-keys 。残高を読む公開 API は無いので、費用の正は usage ダッシュボードで見る
OPENAI_API_KEY=

# OpenAI の TTS モデル。空なら gpt-4o-mini-tts（ほかに tts-1 / tts-1-hd）
OPENAI_TTS_MODEL=

# OpenAI の声。空なら marin（公式ガイドが音質で推すのは marin / cedar。2026-09-25 確認）。
# 組み込みは alloy / ash / ballad / coral / echo / fable / nova / onyx / sage / shimmer / verse / marin / cedar
OPENAI_TTS_VOICE=

# F: Google Cloud Text-to-Speech（B の TTS を Chirp 3 HD の日本語の声に替えたもの）。REST は API キーで呼べる
# https://console.cloud.google.com/apis/credentials → Cloud Text-to-Speech API を有効化したプロジェクトのキー
GOOGLE_TTS_API_KEY=

# Google の声（Chirp 3 HD の日本語は 30 声。2026-09-25 に GET /v1/voices?languageCode=ja-JP で確認）。
# 空なら ja-JP-Chirp3-HD-Kore（既定・女性）。女性は Achernar / Aoede / Autonoe / Callirrhoe / Despina /
# Erinome / Gacrux / Kore / Laomedeia / Leda / Pulcherrima / Sulafat / Vindemiatrix / Zephyr。
# 一覧と男性の声は voicelab/google_path.py の説明にある
GOOGLE_TTS_VOICE=
